# Copy to .env to change anything. The lab runs with none of this set.
# Never commit a real .env file.

MOCK_AI=true
AI_PROVIDER=mock            # mock | anthropic | openai | gemini | bedrock | azure | huggingface | ollama
GITHUB_ENABLED=false
DATABASE_URL=postgresql+psycopg://lab:lab-local-only@db:5432/lab

# --- Optional: real GitHub sandbox repository (see docs/github-sandbox-setup.md) ---
GITHUB_TOKEN=
GITHUB_REPO=                # owner/ai-sdlc-champion-sandbox

# --- Optional: real model providers (set MOCK_AI=false and AI_PROVIDER) ---
AI_MODEL=                   # model id, required for every real provider
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
AWS_REGION=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=
HF_TOKEN=
OLLAMA_HOST=http://host.docker.internal:11434

# Prices for cost dashboards when using a real provider (USD per million tokens).
AI_PRICE_IN_PER_MTOK=
AI_PRICE_OUT_PER_MTOK=
